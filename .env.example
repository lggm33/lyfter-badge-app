# PostgreSQL local (docker compose up -d). La DB de Railway es producción: su URL
# vive solo en Vercel y en el secret PROD_DATABASE_URL de GitHub, nunca acá.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lyfter_dev"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Firma de los QR rotativos (badges y check-in). Cambiarlo invalida todos los QR en pantalla.
QR_SECRET="generate-with: openssl rand -base64 32"

# Seed del Super Admin inicial (pnpm db:seed)
SUPER_ADMIN_EMAIL="admin@lyfter.test"
SUPER_ADMIN_PASSWORD="cambiame-en-produccion"
VERCEL_TOKEN=""
